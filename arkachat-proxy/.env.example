# Secrets injected into the shield-proxy containers at start time.
# Copy to .env (git-ignored) and replace EVERY value — the container entrypoint
# refuses to start while any value below is missing or still a placeholder.
#
# Generate high-entropy secrets, e.g.:
#   openssl rand -base64 48

# Shield transport PSK shared between clients and the proxy.
SHIELD_PROXY_PASSWORD=change-me-in-production

# Per-upstream Shield keys — generate with shield-keygen.
SHIELD_PROXY_KEY_SMP4=generate-with-shield-keygen
SHIELD_PROXY_KEY_SMP5=generate-with-shield-keygen
SHIELD_PROXY_KEY_SMP6=generate-with-shield-keygen

# HMAC PSK authenticating active/standby heartbeats (redundancy).
# MUST be identical on both nodes; without it heartbeats could be forged to
# force failover / split-brain.
SHIELD_PROXY_REDUNDANCY_PSK=change-me-in-production

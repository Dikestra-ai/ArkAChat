# ── LLM ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# ── Telegram channel ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADEL_ADMIN_TELEGRAM_ID=123456789

# ── Storage backend: sqlite (default, MVP) or supabase (hosted) ──────
ADEL_STORAGE_BACKEND=sqlite
SQLITE_DB_PATH=./data/adel.db

# Supabase (only when ADEL_STORAGE_BACKEND=supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Calendar ─────────────────────────────────────────────────────────
CALENDAR_BACKEND=stub

# ── ArkAChat SimpleX bridge ──────────────────────────────────────────
# Set to enable routing messages from arkachat-proxy (SimpleX protocol)
# ARKACHAT_PROXY_URL=http://localhost:5000
# ARKACHAT_BRIDGE_SECRET=changeme

# ── Gibraltar orchestration ──────────────────────────────────────────
GIBRALTAR_SESSION_NAME=assistant

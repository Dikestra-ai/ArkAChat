%% vim: ts=4 sw=4 et ft=erlang
{erl_opts, [debug_info]}.

{deps, [
    {cowboy,        "2.10.0"},
    {nitrogen_core, "~> 3.0.0-alpha"},
    {jsx,           "3.1.0"}
]}.

{pre_hooks, [
    {"linux|bsd|darwin|solaris", compile, "./do-plugins.escript"},
    {"linux|bsd|darwin|solaris", compile, "./copy_static.escript link"},
    {"linux|bsd|darwin|solaris", compile,
        "etc/assemble_config.escript etc etc/autogenerated.config.all"}
]}.

%% SECURITY: the release is built in prod mode with no hot-code reloader.
%% `sync` (auto-recompile/hot-load of changed source at runtime) must never
%% ship in a release — it turns any file-write primitive into code execution.
{relx, [
    {release, {arkachat, git}, [
        sasl, cowboy, arkachat
    ]},
    {sys_config,          "etc/autogenerated.config.all"},
    {vm_args,             "etc/vm.args"},
    {dev_mode,            false},
    {mode,                prod},
    {include_erts,        false},
    {extended_start_script, true},
    {overlay, [{copy, "priv", "priv"}]}
]}.

{plugins, [rebar3_run]}.

{shell, [{apps, [arkachat]}]}.

%% ── Test configuration ────────────────────────────────────────────────────────

{eunit_opts, [verbose]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, {d, 'TEST'}]},
        {deps, []},
        {pre_hooks, []},   %% skip release-only hooks during eunit
        {eunit_tests, [
            {dir, "test"}
        ]}
    ]}
]}.

{cover_enabled, true}.
{cover_opts,    [verbose]}.

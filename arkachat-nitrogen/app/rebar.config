%% vim: ts=4 sw=4 et ft=erlang
{erl_opts, [debug_info]}.

{deps, [
    {cowboy, "2.10.0"},
    {nitrogen_core, "~> 3.0.0-alpha"},
    {sync, "0.4.1"},
    {jsx, "3.1.0"}
]}.

{pre_hooks, [
    {"linux|bsd|darwin|solaris", compile, "./do-plugins.escript"},
    {"linux|bsd|darwin|solaris", compile, "./copy_static.escript link"},
    {"linux|bsd|darwin|solaris", compile,
        "etc/assemble_config.escript etc etc/autogenerated.config.all"}
]}.

{relx, [
    {release, {arkachat, git}, [
        sasl,
        cowboy,
        {sync, load},
        arkachat
    ]},
    {sys_config, "etc/autogenerated.config.all"},
    {vm_args, "etc/vm.args"},
    {dev_mode, true},
    {mode, dev},
    {include_erts, false},
    {debug_info, keep},
    {extended_start_script, true},
    {overlay, [{copy, "priv", "priv"}]}
]}.

{plugins, [rebar3_run]}.

{shell, [{apps, [arkachat]}]}.

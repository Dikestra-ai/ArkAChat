%% vim: ts=4 sw=4 et ft=erlang
%% ArkAChat application config.
%% Set ARKACHAT_SHIELD_KEY (64-char hex) in production.
[
    {arkachat, [
        %% 256-bit AES key as hex (overridden by ARKACHAT_SHIELD_KEY env var).
        %% Leave commented out to auto-derive from node name (dev only).
        %% {shield_key_hex, "your64hexcharshere..."},

        %% Built-in bots loaded at startup. Add {id, module} pairs here.
        {bots, [
            {"bot-echo",   bot_echo},
            {"bot-status", bot_status}
        ]},

        %% Optional: URL of the ShieldSimplexBridge HTTP API for cross-platform sync.
        %% If not set, messages are stored locally in ETS.
        %% {bridge_api_url, "http://localhost:9000"}
    ]}
].

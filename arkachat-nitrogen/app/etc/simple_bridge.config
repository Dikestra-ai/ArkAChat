%% vim: ts=4 sw=4 et ft=erlang
%% simple_bridge configuration for ArkAChat.
%% All values are overridable via environment variables — see sys.config.
[
    {simple_bridge, [
        {handler,  nitrogen},
        {backend,  cowboy},

        {address, "0.0.0.0"},
        %% Override with env ARKACHAT_BIND_ADDR

        {port, 8000},
        %% Override with env ARKACHAT_PORT

        {document_root, "./priv/static"},

        {static_paths, ["js/", "css/", "images/", "nitrogen/", "favicon.ico"]},

        {max_post_size,          10},
        {max_file_size,          10},
        {max_file_in_memory_size, 0},
        {scratch_dir,            "./scratch"}
    ]}
].

%% vim: ts=4 sw=4 et ft=erlang
%% ArkAChat application config.
%% A Shield master key is REQUIRED: set ARKACHAT_SHIELD_KEY (64-char hex) in
%% the environment, or shield_key_hex below. The app fails closed (refuses to
%% start) if no key is configured — there is no derived/default key.
[
    {arkachat, [
        %% 256-bit AES key as hex (overridden by ARKACHAT_SHIELD_KEY env var).
        %% Prefer the env var / a secret manager over committing a key here.
        %% {shield_key_hex, "your64hexcharshere..."},

        %% dev_mode: false in production.
        %% Set to true ONLY in a local dev environment to allow sync hot-reload.
        %% The sync hot-reloader must NEVER run in production: it turns any
        %% file-write primitive into code execution. (deployment-006)
        {dev_mode, false},

        %% Built-in bots loaded at startup. Add {id, module} pairs here.
        {bots, [
            {"bot-echo",   bot_echo},
            {"bot-status", bot_status}
        ]}

        %% Optional: URL of the ShieldSimplexBridge HTTP API for cross-platform sync.
        %% If not set, messages are stored locally in ETS.
        %% {bridge_api_url, "http://localhost:9000"}
    ]}
].

%% vim: ts=4 sw=4 et ft=erlang
%% simple_bridge configuration for ArkAChat.
%%
%% TLS (HTTPS) is enabled at runtime if the following env vars are set:
%%   ARKACHAT_TLS_CERT   — path to PEM certificate (or fullchain)
%%   ARKACHAT_TLS_KEY    — path to PEM private key
%%   ARKACHAT_TLS_CA     — path to PEM CA chain (optional)
%% When TLS vars are present, the supervisor injects ssl_opts into this
%% config before starting simple_bridge, and port defaults to 8443.
%%
%% Without TLS env vars the server binds to 127.0.0.1 only — a reverse
%% proxy (nginx / haproxy) must handle TLS termination externally.
[
    {simple_bridge, [
        {handler,  nitrogen},
        {backend,  cowboy},

        %% Bind to loopback by default; set ARKACHAT_BIND_ADDR=0.0.0.0 only
        %% when a TLS-terminating reverse proxy is not in use.
        {address, "127.0.0.1"},

        {port, 8000},
        %% Override with ARKACHAT_PORT. Set to 8443 when using direct TLS.

        {document_root, "./priv/static"},

        {static_paths, ["js/", "css/", "images/", "nitrogen/", "favicon.ico"]},

        {max_post_size,          10},
        {max_file_size,          10},
        {max_file_in_memory_size, 0},
        {scratch_dir,            "./scratch"}

        %% ssl_opts are injected at startup by arkachat_sup when
        %% ARKACHAT_TLS_CERT + ARKACHAT_TLS_KEY env vars are present.
        %% Do NOT add ssl_opts here — the supervisor overwrites this key.
    ]}
].

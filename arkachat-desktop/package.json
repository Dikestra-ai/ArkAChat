{
  "name": "arkachat-desktop",
  "version": "1.0.0",
  "description": "ArkAChat Desktop - Quantum-safe messaging",
  "homepage": "https://github.com/Dikestra-ai/ArkAChat",
  "author": "Dikestra AI <info@dikestra.ai>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dikestra-ai/ArkAChat.git"
  },
  "main": "main/index.js",
  "scripts": {
    "dev": "electron .",
    "build": "npm run build:web && electron-builder",
    "build:web": "cd ../arkachat-web && BUILD_TARGET=electron npm run build && cp -r out ../arkachat-desktop/renderer",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "build:windows": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.1.0",
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.dikestra.arkachat",
    "productName": "ArkAChat",
    "forceCodeSigning": false,
    "afterPack": "./main/afterPack.js",
    "publish": {
      "provider": "github",
      "owner": "Dikestra-ai",
      "repo": "ArkAChat"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/**/*"
    ],
    "asarUnpack": [
      "node_modules/keytar/**"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "target": ["dmg", "zip"],
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": {
        "teamId": "REPLACE_WITH_APPLE_TEAM_ID"
      }
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico",
      "publisherName": "Dikestra AI",
      "signingHashAlgorithms": ["sha256"],
      "verifyUpdateCodeSignature": true
    },
    "linux": {
      "target": ["AppImage", "deb", "rpm"],
      "category": "Network",
      "icon": "assets/icon.png"
    }
  }
}

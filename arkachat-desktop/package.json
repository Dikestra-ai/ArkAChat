{
  "name": "arkachat-desktop",
  "version": "1.0.0",
  "description": "ArkAChat Desktop - Quantum-safe messaging",
  "main": "main/index.js",
  "scripts": {
    "dev": "electron .",
    "build": "npm run build:web && electron-builder",
    "build:web": "cd ../arkachat-web && BUILD_TARGET=electron npm run build && cp -r out ../arkachat-desktop/renderer",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "build:windows": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.1.0",
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "ai.dikestra.arkachat",
    "productName": "ArkAChat",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/**/*"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "target": ["dmg", "zip"],
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb", "rpm"],
      "category": "Network",
      "icon": "assets/icon.png"
    }
  }
}
